{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qbitview",
  "version": "0.1.0",
  "identifier": "com.fatpandac.qbitview",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "qbitview",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyNkNDQkZBMENFMkFDMjcKUldRbnJPSU0rc3Rzd2wvTUxhWXlwTHVwK2VvSUVyUWk1eTlGTXV6Mk1mSGRrd1BCV1k1WlEzUWIK",
      "endpoints": [
        "https://github.com/Fatpandac/qBitView/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
